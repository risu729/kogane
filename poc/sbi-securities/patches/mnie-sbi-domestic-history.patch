+const parseHtmlFormContaining = (html: string, baseUrl: URL, controlName: string) => {
+  const formMatch = [...html.matchAll(/<form\b([^>]*)>([\s\S]*?)<\/form>/gi)].find((match) =>
+    new RegExp(`\\bname=["']${controlName}["']`, 'i').test(match[2] ?? ''),
+  )
+  if (!formMatch) throw new Error(`main site response did not include a ${controlName} form`)
+  const openingTag = `<form${formMatch[1] ?? ''}>`
+  const body = formMatch[2] ?? ''
+  const action = new URL(attributeValue(openingTag, 'action') ?? baseUrl.toString(), baseUrl)
+  const method = (attributeValue(openingTag, 'method') ?? 'GET').toUpperCase()
+  const fields: Array<[string, string]> = []
+  for (const inputMatch of body.matchAll(/<input\b[^>]*>/gi)) {
+    const tag = inputMatch[0]
+    const name = attributeValue(tag, 'name')
+    if (!name || /\bdisabled\b/i.test(tag)) continue
+    const type = (attributeValue(tag, 'type') ?? 'text').toLowerCase()
+    if ((type === 'checkbox' || type === 'radio') && !/\bchecked\b/i.test(tag)) continue
+    if ((type === 'submit' || type === 'button') && name !== controlName) continue
+    fields.push([name, attributeValue(tag, 'value') ?? ''])
+  }
+  for (const selectMatch of body.matchAll(/<select\b([^>]*)>([\s\S]*?)<\/select>/gi)) {
+    const name = attributeValue(`<select${selectMatch[1] ?? ''}>`, 'name')
+    if (!name || /\bdisabled\b/i.test(selectMatch[1] ?? '')) continue
+    const options = [...(selectMatch[2] ?? '').matchAll(/<option\b([^>]*)>([\s\S]*?)<\/option>/gi)]
+    const selected = options.find((option) => /\bselected\b/i.test(option[1] ?? '')) ?? options[0]
+    if (selected) {
+      fields.push([
+        name,
+        attributeValue(`<option${selected[1] ?? ''}>`, 'value') ?? htmlText(selected[2] ?? ''),
+      ])
+    }
+  }
+  return { action, method, fields }
+}
