+const domesticHistoryMarket = (label: string): MarketCode => {
+  if (label.includes('東証')) return 'XTKS'
+  if (label.includes('名証')) return 'XNGO'
+  if (label.includes('福証')) return 'XFKA'
+  if (label.includes('札証')) return 'XSAP'
+  return 'STK'
+}
+
+const domesticHistoryAccountType = (label: string): AccountType => {
+  if (label.includes('特定')) return 'specific'
+  if (label.includes('一般')) return 'general'
+  if (label.includes('NISA(成)') || label.includes('NISA（成）')) return 'growthInvestment'
+  if (label.includes('NISA')) return 'nisa'
+  return 'unknown'
+}
