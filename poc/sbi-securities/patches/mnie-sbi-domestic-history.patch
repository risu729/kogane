+const parseDomesticTradeRecords = (html: string, limit: number): TradeRecordList => {
+  const table = [...html.matchAll(/<table\b[^>]*>([\s\S]*?)<\/table>/gi)]
+    .map((match) => match[1] ?? '')
+    .find(
+      (candidate) =>
+        htmlText(candidate).includes('約定日') && htmlText(candidate).includes('約定数量'),
+    )
+  if (!table) {
+    if (/\bname=["']ACT_search["']/i.test(html)) return { records: [], hasMore: false }
+    throw new Error('SBI domestic trade history response did not include a result table')
+  }
+
+  const parsedRecords = [...table.matchAll(/<tr\b[^>]*>([\s\S]*?)<\/tr>/gi)]
+    .map((row) =>
+      [...(row[1] ?? '').matchAll(/<t[dh]\b[^>]*>([\s\S]*?)<\/t[dh]>/gi)].map((cell) =>
+        htmlText(cell[1] ?? ''),
+      ),
+    )
+    .filter((cells) => cells.length === 7 && /^\d{2}\/\d{2}\/\d{2}$/.test(cells[0] ?? ''))
+    .map((cells): TradeRecord => {
+      const issueText = cells[1] ?? ''
+      const issueMatch = issueText.match(/^(.+?)\s+([0-9A-Z]{4})\s+(.+)$/)
+      const issueCode = issueMatch?.[2] ?? ''
+      const marketLabel = issueMatch?.[3] ?? ''
+      const tradeAccountMatch = (cells[2] ?? '').match(/^(.+?)\s+([^/]+)\/\s*(.*)$/)
+      const quantityPriceMatch = (cells[3] ?? '').match(/^([\d,.+-]+)\s+([\d,.+-]+)$/)
+      const valueDateAmountMatch = (cells[5] ?? '').match(
+        /^(\d{2}\/\d{2}\/\d{2})\s+([\d,.+△()-]+)$/,
+      )
+      const tradeDate = domesticHistoryIsoDate(cells[0] ?? '')
+      const valueDate = domesticHistoryIsoDate(valueDateAmountMatch?.[1] ?? '')
+      const tradeRecordTypeCode = tradeAccountMatch?.[1]?.trim() ?? cells[2]
+      return {
+        id: [issueCode, tradeDate, tradeRecordTypeCode, valueDate, cells[3], cells[5]]
+          .filter(Boolean)
+          .join(':'),
+        issue: {
+          code: issueCode,
+          market: domesticHistoryMarket(marketLabel),
+          name: issueMatch?.[1]?.trim() ?? issueText,
+        },
+        tradeRecordTypeCode,
+        tradeCurrencyCode: 'JPY',
+        accountType: domesticHistoryAccountType(tradeAccountMatch?.[2] ?? ''),
+        settlementCurrencyCode: 'JPY',
+        amount: yen(valueDateAmountMatch?.[2] ?? ''),
+        quantity: parseNumber(quantityPriceMatch?.[1] ?? ''),
+        price: yen(quantityPriceMatch?.[2] ?? ''),
+        tradeDate,
+        valueDate,
+      }
+    })
+  const occurrenceCounts = new Map<string, number>()
+  const records = parsedRecords.map((record) => {
+    const occurrence = (occurrenceCounts.get(record.id) ?? 0) + 1
+    occurrenceCounts.set(record.id, occurrence)
+    return { ...record, id: `${record.id}:${occurrence}` }
+  })
+
+  return { records, hasMore: records.length >= limit }
+}
