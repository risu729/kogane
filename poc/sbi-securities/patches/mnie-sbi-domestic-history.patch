+const domesticHistoryIsoDate = (value: string) => {
+  const match = value.trim().match(/^(\d{2})\/(\d{2})\/(\d{2})$/)
+  if (!match) return undefined
+  return `20${match[1]}-${match[2]}-${match[3]}`
+}
