+  }
+  const defaultFromDate = new Date(`${to}T00:00:00.000Z`)
+  defaultFromDate.setUTCDate(defaultFromDate.getUTCDate() - 89)
+  const from = options.from ?? defaultFromDate.toISOString().slice(0, 10)
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(from) || from > to) {
+    throw new Error('orders.inquiry.tradeRecords requires a valid from-to range')
+  }
+  const auth = await ensureMainSiteAuth(session)
+  const { response: initialResponse, cookies } = await fetchMainSiteAuthenticatedPage(
+    session,
+    auth,
+    (authenticatedHtml, responseUrl) => {
+      const historyLinks = [
+        ...authenticatedHtml.matchAll(
+          /<a\b[^>]*href=["']([^"']*WPLETacR007Control[^"']*)["'][^>]*>([\s\S]*?)<\/a>/gi,
+        ),
+      ]
+      const encodedHref = historyLinks[0]?.[1]
+      if (!encodedHref) {
+        throw new Error('SBI authenticated page did not include the domestic trade history link')
+      }
+      return new URL(encodedHref.replace(/&amp;/gi, '&'), responseUrl)
+    },
+  )
+  let response = initialResponse
+  let html = decodeShiftJis(Buffer.from(await response.arrayBuffer()))
+  if (!response.ok) {
+    throw new Error(`SBI domestic trade history failed with HTTP ${response.status}`)
+  }
+  if (textFromTitle(html)?.includes('メンテナンス')) {
+    throw new Error('SBI domestic trade history is unavailable during maintenance')
+  }
+  const searchForm = parseHtmlFormContaining(html, new URL(response.url), 'ACT_search')
+  const [fromYear, fromMonth, fromDay] = from.split('-')
+  const [toYear, toMonth, toDay] = to.split('-')
+  const searchFields = new URLSearchParams(searchForm.fields)
+  searchFields.set('ref_from_yyyy', fromYear ?? '')
+  searchFields.set('ref_from_mm', fromMonth ?? '')
+  searchFields.set('ref_from_dd', fromDay ?? '')
+  searchFields.set('ref_to_yyyy', toYear ?? '')
+  searchFields.set('ref_to_mm', toMonth ?? '')
+  searchFields.set('ref_to_dd', toDay ?? '')
+  searchFields.set('max_cnt', String(Math.min(Math.max(options.limit ?? 200, 1), 200)))
+  const searchResponse = await fetch(searchForm.action, {
+    method: searchForm.method,
+    headers: {
+      accept: 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
+      'content-type': 'application/x-www-form-urlencoded',
+      cookie: cookieHeader(cookies, searchForm.action),
+      referer: response.url,
+      'user-agent': MAIN_SITE_USER_AGENT,
+    },
+    body: searchFields,
+    redirect: 'manual',
+  })
+  updateCookieJar(cookies, searchResponse, searchForm.action)
+  response = searchResponse
+  if (searchResponse.headers.has('location')) {
+    const resultUrl = responseLocationUrl(searchResponse, searchForm.action)
+    response = await fetch(resultUrl, {
+      headers: {
+        accept: 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
+        cookie: cookieHeader(cookies, resultUrl),
+        referer: searchForm.action.toString(),
+        'user-agent': MAIN_SITE_USER_AGENT,
+      },
+      redirect: 'manual',
+    })
+    updateCookieJar(cookies, response, resultUrl)
+  }
+  html = decodeShiftJis(Buffer.from(await response.arrayBuffer()))
+  if (!response.ok) {
+    throw new Error(`SBI domestic trade history search failed with HTTP ${response.status}`)
+  }
+  return parseDomesticTradeRecords(html, Math.min(Math.max(options.limit ?? 200, 1), 200))
+}
