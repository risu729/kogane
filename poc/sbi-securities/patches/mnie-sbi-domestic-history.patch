+const fetchDomesticTradeRecords = async (
+  session: SbiSession,
+  options: TradeRecordInquiryOptions,
+): Promise<TradeRecordList> => {
+  const to = options.to ?? new Date().toISOString().slice(0, 10)
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(to)) {
