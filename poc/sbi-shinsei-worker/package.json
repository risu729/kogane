{
  "name": "@kogane/poc-sbi-shinsei-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test && bash test/admin-token-sync.test.sh && bun run test:relay",
    "test:relay": "node --test container/relay-lifecycle.node-test.mjs container/child-lifecycle.node-test.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf:types": "wrangler types",
    "cf:check": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy",
    "local:collect": "bun run src/local/cli.ts",
    "local:check": "bun run src/local/cli.ts --dry-run",
    "local:check-jsc": "bun run src/local/check-jsc.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.127.1",
    "ws": "8.21.3"
  }
}
