{
  "name": "@kogane/poc-sbi-vc-trade-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run test:unit && bun run test:workers",
    "test:unit": "bun test ./test/*.test.ts",
    "test:workers": "vitest run",
    "cf:types": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --strict-vars false",
    "typecheck": "bun run cf:types && tsc --noEmit",
    "cf:check": "wrangler deploy --dry-run",
    "cf:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.2",
    "@types/bun": "1.3.8",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
