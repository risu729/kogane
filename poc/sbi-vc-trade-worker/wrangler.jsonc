{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-sbi-vc-session-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_STATE",
        "class_name": "SbiVcSessionState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SbiVcSessionState"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
