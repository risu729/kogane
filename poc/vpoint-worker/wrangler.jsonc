{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-vpoint-collector-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "kogane-vpoint-collector-poc"
    }
  ],
  "vars": {
    "COLLECTOR_SCHEMA_VERSION": "vpoint-worker-poc-v1"
  },
  "secrets": {
    "required": ["VPOINT_SESSION_COOKIE", "ADMIN_TRIGGER_TOKEN"]
  },
  "triggers": {
    "crons": ["15 21 * * *"]
  }
}
