{
  "name": "@kogane/poc-observation-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "bun run src/demo.ts",
    "ingest": "bun run src/ingest.ts",
    "parse": "bun run src/parse.ts",
    "serve": "bun run src/serve.ts",
    "preview": "bun run build && bun run src/serve.ts --demo",
    "dev": "vite",
    "build": "vite build",
    "build:evidence": "vite build --mode evidence --outDir dist-evidence",
    "build:production": "vite build --mode production --outDir dist-production",
    "export:demo": "bun run src/export-demo.ts ../../services/evidence-browser/demo-snapshot.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.3",
    "hono": "4.13.5",
    "jsonc-parser": "3.3.1",
    "parse5": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
