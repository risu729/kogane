amends "https://raw.githubusercontent.com/risu729/hk-config/v2.0.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v2.0.0/helpers.pkl"

// Evidence and parser fixtures retain their exact committed bytes.
exclude = List("data/**", "**/fixtures/**", "**/patches/**", "**/worker-configuration.d.ts")

local picked =
  helpers.pick(new Listing {
    "oxlint"
    "oxfmt"
    "github-actions"
    "tombi"
    "yaml"
    "typos"
    "hygiene"
    "shellcheck"
  })

// Top-level steps feed hk's implicit check, fix and pre-commit hooks, so fast
// staged-file fixes stay in pre-commit.
steps = (picked) {
  ["hygiene"] = (picked["hygiene"] as Group) {
    steps = ((picked["hygiene"] as Group).steps) {
      ["fix-smart-quotes"] = ((picked["hygiene"] as Group).steps["fix-smart-quotes"]) {
        // The synthetic request-error page mirrors the curly apostrophes the bank page shows.
        exclude = List("experiments/st-george-automation/test/probe.test.ts")
      }
    }
  }
  // Direct exit status also works on Windows; the preset's diff wrapper is Bash.
  ["typos"] = new Step {
    check = "typos --force-exclude {{ files }}"
    fix = "typos --force-exclude --write-changes {{ files }}"
  }
  ["ruff"] = new Step {
    glob = "**/*.py"
    check = "ruff check {{ files }}"
    fix = "ruff check --fix {{ files }}"
  }
  ["ruff-format"] = new Step {
    glob = "**/*.py"
    check_diff = "ruff format --check --diff {{ files }}"
    fix = "ruff format {{ files }}"
  }
}

// The complete verification graph belongs only to check. No glob/profile means
// it also runs with no changed files.
hooks {
  ["check"] {
    steps {
      ["repository"] = new Step {
        check = "mise run --continue-on-error checks"
      }
    }
  }
}
