{
  // ref: https://docs.renovatebot.com/configuration-options/
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The shared preset already pins versions, automerges minor and digest
  // updates, and keeps the Miniflare -> compatibility_date manager working for
  // wrangler.jsonc. Normal updates therefore reach main through CI Check and
  // native auto-merge without extra rules here.
  extends: ["github>risu729/renovate-config#3.23.3"],
  packageRules: [
    {
      // Historical rollback checkouts without cf build output still require the
      // Wrangler-based v1 API. Remove this limit when those rollback targets are
      // no longer supported; the current cf deployment steps (v3) stay updatable.
      matchManagers: ["github-actions"],
      matchFileNames: [".github/workflows/_deploy-workers.yml"],
      matchPackageNames: ["risu729/wrangler-deploy-action"],
      matchCurrentValue: "/^v1\\./",
      allowedVersions: "<2",
    },
    {
      // The Workers toolchain is version-coupled: wrangler, its runtime and the
      // test runtime have to move together or the dry runs disagree.
      matchPackageNames: ["wrangler", "miniflare", "@cloudflare/**"],
      groupName: "cloudflare workers",
      addLabels: ["workers"],
    },
    {
      // ADR 0110: these releases bundle the upstream CTE expansion regression.
      // Exclude exact observed releases; future fixes still enter normal CI.
      matchPackageNames: ["wrangler"],
      allowedVersions: "!/^4\\.(159\\.0|160\\.[01]|161\\.0)$/",
    },
    {
      // These Vitest releases depend on the same affected Wrangler runtimes.
      matchPackageNames: ["@cloudflare/vitest-plugin"],
      allowedVersions: "!/^1\\.(6\\.1|7\\.0|8\\.[01])$/",
    },
    {
      // The preset groups "typescript" already; keep the type packages with it.
      matchPackageNames: ["typescript", "@types/**"],
      groupName: "typescript",
    },
    {
      // Both need the in-process TypeScript < 7 compiler API, which 7.0 no
      // longer ships (docs/tooling.md): dependency-cruiser at the root
      // (docs/package-layout.md) and collector-globalpass's Turnstile
      // capture analysis scripts.
      matchFileNames: ["package.json", "services/collector-globalpass/package.json"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      matchFileNames: ["services/**", "packages/**"],
      addLabels: ["deployed"],
    },
  ],
}
