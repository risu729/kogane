{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Knip runs in advisory mode (`mise run root:knip`, `--no-exit-code`): it
  // reports unused-looking files, exports and dependencies and never decides
  // anything. Acceptance G4-13 — a runtime entry point that knip cannot see is
  // the normal case here, not an exception — so nothing is deleted because it
  // appears below, and `docs/unused-report.md` says what each finding means.

  "ignore": [
    // Generated by `wrangler types`, not tracked.
    "**/worker-configuration.d.ts",
    // Synthetic fixtures are data a test reads by path, not modules.
    "**/fixtures/**",
    "data/**"
  ],

  "ignoreDependencies": [
    // mise owns every entry point (decision D4), so the locked binaries are
    // called as `./node_modules/.bin/<tool>` from a `tasks.toml`. Knip reads
    // package scripts, of which this repository deliberately has none, so it
    // cannot see those invocations and would report each one as unused.
    "wrangler",
    "vitest",
    // `cloudflare:workers` and `cloudflare:test` are workerd's built-in
    // modules; there is no `cloudflare` package to depend on.
    "cloudflare"
  ],

  "ignoreBinaries": [
    // Operator tools a human runs from a documented shell script, never CI.
    "bw",
    "docker",
    "jq"
  ],

  "workspaces": {
    ".": {
      // The ledger generators and the CI guards. Each is run by a mise task as
      // a file path, so nothing imports them.
      "entry": ["scripts/*.ts", "tasks/_lib/*.ts"],
      "project": ["scripts/**/*.ts", "tasks/**/*.ts"]
    },
    "experiments/*": {
      // An experiment's Worker entry comes from its wrangler config; the rest
      // of `src/` is diagnostic code that is meant to be reachable by hand.
      "entry": ["src/**/*.ts"],
      "wrangler": { "config": ["wrangler*.jsonc"] }
    },
    "packages/*": {
      // A shared package is consumed by repository-relative import, which knip
      // resolves across workspaces, so only the barrel and the tests are roots.
      // Packages with an `exports` map need no entry at all.
      "entry": ["src/index.ts", "test/**/*.test.ts"]
    },
    "poc/*": {
      // `bun test` has no knip plugin: without this every test helper reads as
      // unused. Only `poc/observation-pipeline` is left here (its split is a
      // later U04 row); the block goes with it.
      "entry": ["test/**/*.test.ts", "scripts/*.ts"]
    },
    "poc/observation-pipeline": {
      "entry": ["test/**/*.test.ts", "scripts/*.ts", "web/**/*.tsx"]
    },
    "services/*": {
      "entry": ["test/**/*.test.ts", "scripts/*.ts"],
      // `wrangler.demo.jsonc`, `wrangler.test.jsonc` and the importer's audit
      // configs each name a different `main`; all of them are real entry points.
      "wrangler": { "config": ["wrangler*.jsonc"] }
    }
  }
}
