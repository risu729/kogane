{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Knip reads workspace mise.toml tasks with its native mise plugin.
  // `mise run root:knip` rejects unresolved imports and undeclared dependencies,
  // then reports unused files, exports and dependencies with --no-exit-code.
  // Unused candidates remain advisory (G4-13): a runtime entry point may be
  // invisible to static analysis. No finding alone authorizes a deletion;
  // `docs/unused-report.md` records the interpretation and review policy.

  "ignore": [
    // Generated by `wrangler types`, not tracked.
    "**/worker-configuration.d.ts",
    // Synthetic fixtures are data a test reads by path, not modules.
    "**/fixtures/**",
    "data/**"
  ],

  "ignoreDependencies": [
    // `cloudflare:workers` and `cloudflare:test` are workerd's built-in
    // modules; there is no `cloudflare` package to depend on.
    "cloudflare"
  ],

  "ignoreBinaries": [
    // Operator tools a human runs from a documented shell script, never CI.
    "bw",
    "docker",
    "jq"
  ],

  "workspaces": {
    ".": {
      // The ledger generators and the CI guards. Each is run by a mise task as
      // a file path, so nothing imports them.
      "entry": ["scripts/*.{ts,mjs}", "tasks/_lib/**/*.{ts,mjs}", "tests/**/*.test.ts"],
      "project": ["scripts/**/*.{ts,mjs}", "tasks/**/*.{ts,mjs}", "tests/**/*.ts"],
      // This binary is spawned by tasks/_lib/depcruise.ts, not a shell task.
      "ignoreDependencies": ["dependency-cruiser"]
    },
    "experiments/*": {
      // An experiment's Worker entry comes from its wrangler config; the rest
      // of `src/` is diagnostic code that is meant to be reachable by hand.
      "entry": ["src/**/*.ts", "container/server.ts"],
      "wrangler": { "config": ["wrangler*.jsonc"] }
    },
    "packages/sbi-vc-trade-client": {
      "entry": ["src/index.ts", "src/cli.ts", "test/**/*.test.ts"]
    },
    "services/collector-vpass": {
      "entry": [
        "test/**/*.test.ts",
        "src/{cli,mobile-cli,live-smoke,mobile-auth-probe,fingerprint}.ts"
      ],
      "wrangler": { "config": ["wrangler*.jsonc"] }
    },
    "packages/*": {
      // A shared package is consumed by repository-relative import, which knip
      // resolves across workspaces, so only the barrel and the tests are roots.
      // Packages with an `exports` map need no entry at all.
      "entry": ["src/index.ts", "test/**/*.test.ts"]
    },
    "services/collector-globalpass/container": {
      // Independently installed image dependencies have their own npm lockfile.
      "entry": ["server.mjs"],
      "ignoreBinaries": ["Xvfb"]
    },
    "services/collector-sbi-shinsei/container": {
      "entry": ["server.mjs", "*.node-test.mjs"],
      // Xvfb is installed by the image; the missing executable is a test fixture.
      "ignoreBinaries": ["Xvfb", "kogane-synthetic-missing-executable"]
    },
    "services/*": {
      "entry": ["test/**/*.{test.ts,test.mjs,node.mjs}", "scripts/**/*.{ts,mjs}", "src/local/*.ts"],
      // Wrangler configs name the Worker entry points, including test variants.
      "wrangler": { "config": ["wrangler*.jsonc"] }
    }
  }
}
