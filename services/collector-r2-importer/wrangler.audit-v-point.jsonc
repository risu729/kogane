{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kogane-vpoint-r2-contract-audit-local",
  "main": "src/v-point-audit-worker.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "VPOINT_SNAPSHOTS",
      "bucket_name": "kogane-vpoint-collector-poc",
      "remote": true
    },
    {
      "binding": "VPOINT_PAY_SNAPSHOTS",
      "bucket_name": "kogane-vpoint-pay-collector-poc",
      "remote": true
    }
  ]
}
