{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-collector-r2-importer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "RAW_EVIDENCE_TOKEN",
      "RAW_EVIDENCE_TOKEN_SBI_VC",
      "RAW_EVIDENCE_TOKEN_SONY",
      "RAW_EVIDENCE_TOKEN_SBI_SHINSEI",
      "RAW_EVIDENCE_TOKEN_MOBILE_SUICA",
      "RAW_EVIDENCE_TOKEN_GLOBAL_PASS",
      "GLOBAL_PASS_LEGACY_EMPTY_SHA256_ALLOWLIST",
      "RAW_EVIDENCE_TOKEN_MYJCB",
      "RAW_EVIDENCE_TOKEN_VPOINT",
      "RAW_EVIDENCE_TOKEN_SMBC_DIRECT",
      "ORIGIN_FINGERPRINT_KEY"
    ]
  },
  "r2_buckets": [
    {
      "binding": "SBI_SNAPSHOTS",
      "bucket_name": "kogane-sbi-collector-poc"
    },
    {
      "binding": "SBI_VC_SNAPSHOTS",
      "bucket_name": "kogane-sbi-vc-trade-poc"
    },
    {
      "binding": "SONY_SNAPSHOTS",
      "bucket_name": "kogane-sony-bank-collector-poc"
    },
    {
      "binding": "SBI_SHINSEI_SNAPSHOTS",
      "bucket_name": "kogane-sbi-shinsei-collector-poc"
    },
    {
      "binding": "MOBILE_SUICA_SNAPSHOTS",
      "bucket_name": "kogane-mobile-suica-collector-poc"
    },
    {
      "binding": "GLOBAL_PASS_SNAPSHOTS",
      "bucket_name": "kogane-globalpass-collector-poc"
    },
    {
      "binding": "MYJCB_SNAPSHOTS",
      "bucket_name": "kogane-myjcb-collector-poc"
    },
    {
      "binding": "VPOINT_SNAPSHOTS",
      "bucket_name": "kogane-vpoint-collector-poc"
    },
    {
      "binding": "VPOINT_PAY_SNAPSHOTS",
      "bucket_name": "kogane-vpoint-pay-collector-poc"
    },
    {
      "binding": "SMBC_DIRECT_SNAPSHOTS",
      "bucket_name": "kogane-smbc-direct-backfill-poc"
    }
  ],
  "services": [
    {
      "binding": "RAW_EVIDENCE",
      "service": "kogane-ingest"
    }
  ],
  "vars": {
    "IMPORTER_VERSION": "collector-r2-importer-v14"
  }
}
