    "cf:check:audit-myjcb": "wrangler deploy --dry-run --config wrangler.audit-myjcb.jsonc",
    "cf:check:audit-sony-layer-b": "wrangler deploy --dry-run --config wrangler.audit-sony-layer-b.jsonc",
