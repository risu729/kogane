{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // packages/application, packages/domain and packages/read-model import
    // each other with explicit .ts extensions; the bundler resolves them and
    // nothing is emitted here.
    "allowImportingTsExtensions": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // As in every packages/* workspace: library declarations are not checked
    // here. The MCP SDK's ship a stdio helper typed on Node's `Buffer`, which a
    // Worker never imports (ADR 0047).
    "skipLibCheck": true,
    "types": []
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
