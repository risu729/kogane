{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-evidence-browser",
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BALANCE_PROJECTION_ENABLED": "0",
    // U11: with this off the v2 balance routes read the CORE projection of
    // migration 0030; with it on they read the READ database below, and a
    // cursor from the other store is refused rather than reinterpreted.
    "READ_PROJECTION_ENABLED": "false",
    "REWARDS_V2_ENABLED": "false",
    // U16: with this off the reward routes answer from CORE's rules and claims
    // at request time; with it on they read the reward snapshot published in
    // the READ database, and `/api/v2/rewards/simulations` is served.
    "REWARD_READ_PROJECTION_ENABLED": "false",
    "EVIDENCE_SOURCE_ID": "sony-bank",
    "EVENTS_V2_ENABLED": "0",
    "ACCESS_ISSUER": "https://risu729.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "20cc9cb6173e2755bc3ffd5f43a9adf45b0c2ad8451a1b2d330cc2b75f0d85c8",
    "COMMANDS_ENABLED": "",
    // The command/operations allow-lists (docs/change-lifecycle.md §Grants).
    // Both are JSON arrays of verified Access subjects and both are empty
    // here, which is the intended shipped state: nobody can approve or commit
    // until a deployment names its operator in `OPERATOR_SUBJECTS`, and a
    // subject in neither list is refused with `subject_not_granted`.
    "OPERATOR_SUBJECTS": "",
    "AGENT_GRANTS": "",
    "AGENT_API_GRANTS": "",
    "OPS_API_ENABLED": "",
    "SESSION_REFRESH_POLICY": "",
    // U14 postcheck (plan 11 §6, docs/ci-cd.md). The release stamps the
    // deployed commit into this variable before the upload
    // (`.github/scripts/release-sha.mjs`), because the pinned deploy Action
    // has no input for a variable; it is empty in the repository and in every
    // local run, and `/api/ops/v1/health` reports it as the build identity.
    "RELEASE_SHA": "",
    // The Access service tokens that may read `/api/ops/v1/health`, as a JSON
    // array of the tokens' common names (their Client IDs). Empty means none:
    // then only the operator's own session can read it and CD's postcheck
    // fails, which is the intended direction for a list that grants access.
    "HEALTH_PROBE_TOKENS": ""
  },
  // The Processor is published on no hostname (`workers_dev: false`, no
  // routes), so this binding is also how the release postcheck reaches its
  // `/internal/health`. It is the binding the change lifecycle already used;
  // no Worker, class, queue, bucket or cron identity changes with it.
  "services": [{ "binding": "PIPELINE", "service": "kogane-observation-pipeline" }],
  "assets": {
    "directory": "../../apps/web/dist-production",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60"
    },
    // The rebuildable read model (plan 04 §1): `kogane-read`, created empty on
    // 2026-09-11; its migrations are applied by the deploy step. This Worker
    // only reads it, and never applies its migrations: that is the processor's
    // `wrangler.read-migrations.jsonc` step.
    {
      "binding": "READ",
      "database_name": "kogane-read",
      "database_id": "320ebe31-a031-48a1-985f-0e6fabbd517a"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "kogane-raw-evidence" }]
}
