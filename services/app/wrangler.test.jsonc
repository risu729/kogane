{
  "name": "kogane-evidence-browser-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BALANCE_PROJECTION_ENABLED": "0",
    "READ_PROJECTION_ENABLED": "false",
    "REWARD_READ_PROJECTION_ENABLED": "false",
    "REWARDS_V2_ENABLED": "false",
    "EVIDENCE_SOURCE_ID": "sony-bank",
    "EVENTS_V2_ENABLED": "0",
    "ACCESS_ISSUER": "https://evidence-test.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "synthetic-test-audience",
    "COMMANDS_ENABLED": "",
    // Empty like the production config: every suite that needs an operator or
    // an agent declares it per request, so no test inherits a grant.
    "OPERATOR_SUBJECTS": "",
    "AGENT_GRANTS": "",
    "AGENT_API_GRANTS": "",
    "OPS_API_ENABLED": "",
    "SESSION_REFRESH_POLICY": ""
  },
  "assets": {
    "directory": "test/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    // A local READ database for the suite; the read migrations are applied to
    // it in test/apply-migrations.ts, so no test depends on the account.
    {
      "binding": "READ",
      "database_name": "test-read",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "test" }]
}
