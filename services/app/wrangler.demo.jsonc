{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-demo",
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "main": "src/demo-worker.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BALANCE_PROJECTION_ENABLED": "0",
    "ACCESS_ISSUER": "https://risu729.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "036dc6fd21306c63c9340ad9ea642f2f7fe550bce61c48a08c7719b02d94cbf9",
    // The demo serves a fixed synthetic snapshot and has no store to accept an
    // operation into; the flag is declared here only to state that it is off.
    "OPS_API_ENABLED": "",
    // Declared for the same reason: the demo Worker has no command surface at
    // all, so it grants no subject anything. An empty list is the deny-all
    // state, not an unconfigured one (docs/change-lifecycle.md §Grants).
    "OPERATOR_SUBJECTS": "",
    "AGENT_GRANTS": "",
    // The demo has no database binding at all, by design: it answers from a
    // committed synthetic snapshot. The READ flag is declared to state that it
    // is off, and no READ binding is added — a public demo is not given a
    // handle on the production read model (U11, docs/read-model-d1.md).
    "READ_PROJECTION_ENABLED": "false"
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  }
}
