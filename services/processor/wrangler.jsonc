{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-observation-pipeline",
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "RECONCILIATION_ENABLED": "true",
    "REWARD_CLAIMS_ENABLED": "true",
    // U16: with this off the reward lane does not run and nothing is written
    // to the READ database; CORE's reward tables keep working unchanged.
    "REWARD_READ_PROJECTION_ENABLED": "true",
    "REPORTS_ENABLED": "true",
    "BALANCE_PROJECTION_ENABLED": "1",
    // U11: with this off the balance projection keeps writing the CORE tables
    // of migration 0030; with it on the same build writes the READ database
    // below and completes the CORE job only after READ is published.
    "READ_PROJECTION_ENABLED": "true",
    "RELEASE_CANDIDATES_ENABLED": "true",
    // U08: the queue, R2 notification rule and ingest-client routes are live.
    // The shared layout is consumed before collectors switch their target.
    "SHARED_R2_INGEST_ENABLED": "true",
    "OPS_DISPATCH_ENABLED": "true",
    // The shared DATA bucket is the existing central bucket; the name is
    // declared so a notification about another bucket is refused.
    "COLLECTION_DATA_BUCKET": "kogane-raw-evidence",
    "COLLECTION_ACCOUNT_ID": "59ea63cc00914b30ca410b062ae2bb7f",
    // The ingest client the Processor registers as. Its client row and its
    // per-source routes are CORE rows created per source by U09.
    "COLLECTION_INGEST_CLIENT": "processor-shared-r2",
    // U14 postcheck (plan 11 §6, docs/processor.md). The release stamps the
    // deployed commit here before the upload
    // (`.github/scripts/release-sha.mjs`), because the pinned deploy Action
    // has no input for a variable; it is empty in the repository and in every
    // local run. `/internal/health` reports it, and the App's health route
    // relays it, which is how CD sees that this Worker carries the release it
    // just uploaded.
    "RELEASE_SHA": ""
  },
  // Provisioned 2026-09-12 with its DLQ and the central R2 object-creation
  // notification rule (prefix runs/, suffix /terminal.json).
  "queues": {
    "consumers": [
      {
        "queue": "kogane-collection-terminals",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "kogane-collection-terminals-dlq",
        "max_concurrency": 2
      }
    ]
  },
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60",
      "migrations_dir": "../../packages/storage-d1/migrations/core"
    },
    // The rebuildable read model (plan 04 §1): `kogane-read`, created empty on
    // 2026-09-11; its migrations are applied by the deploy step. Dry runs and
    // tests never contact it. Wrangler allows one `migrations_dir` per
    // configuration, so the READ migrations are applied through
    // `wrangler.read-migrations.jsonc` (docs/read-rebuild-runbook.md).
    {
      "binding": "READ",
      "database_name": "kogane-read",
      "database_id": "320ebe31-a031-48a1-985f-0e6fabbd517a"
    }
  ],
  // EVIDENCE and DATA are the same physical bucket: the shared collection
  // layout (plan 03 §1) reuses the central raw-evidence bucket rather than
  // creating a second original. DATA is the binding the fixed projection
  // inputs of `projection-inputs/<digest>` are written through.
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "kogane-raw-evidence" },
    { "binding": "DATA", "bucket_name": "kogane-raw-evidence" }
  ]
}
