{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-sbi-vc-session-poc",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "kogane-sbi-vc-trade-poc"
    },
    // U09: the shared DATA bucket this collector writes runs and terminals to
    // once COLLECTION_TARGET is "shared". The legacy SNAPSHOTS staging bucket
    // stays bound and unchanged until U15 retires it.
    {
      "binding": "DATA",
      "bucket_name": "kogane-raw-evidence"
    }
  ],
  "services": [
    {
      "binding": "RAW_EVIDENCE_IMPORTER",
      "service": "kogane-collector-r2-importer"
    }
  ],
  "vars": {
    // "legacy" (default) keeps the per-source bucket plus the central importer
    // upload; "shared" writes the run to DATA and skips the importer (D12).
    "COLLECTION_TARGET": "shared",
    "COLLECTOR_SCHEMA_VERSION": "sbi-vc-trade-worker-poc-v1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_STATE",
        "class_name": "SbiVcSessionState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SbiVcSessionState"]
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "5 21 * * *"]
  }
}
