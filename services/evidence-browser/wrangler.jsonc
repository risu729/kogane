{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-evidence-browser",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "EVIDENCE_SOURCE_ID": "sony-bank",
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": ""
  },
  "assets": {
    "directory": "../../poc/observation-pipeline/web/dist-evidence",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "kogane-raw-evidence" }]
}
