{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // @kogane/domain is imported by relative path and uses explicit .ts
    // specifiers internally, like services/observation-pipeline does.
    "allowImportingTsExtensions": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": []
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
