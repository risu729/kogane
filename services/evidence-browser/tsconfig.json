{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // packages/application and packages/domain import each other with explicit
    // .ts extensions; the bundler resolves them and nothing is emitted here.
    "allowImportingTsExtensions": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": []
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
