{
  "name": "kogane-evidence-browser-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Reader side of the balance projection; off keeps /api/balances on
    // today's query path (docs/balance-read-model.md).
    "BALANCE_PROJECTION_ENABLED": "0",
    "EVIDENCE_SOURCE_ID": "sony-bank",
    "ACCESS_ISSUER": "https://evidence-test.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "synthetic-test-audience"
  },
  "assets": {
    "directory": "test/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "test" }]
}
