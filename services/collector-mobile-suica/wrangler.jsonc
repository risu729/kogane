{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-mobile-suica-collector-poc",
  "main": "src/schedule-entrypoint.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": ["JRE_ID_CREDENTIAL_JSON"]
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "kogane-raw-evidence"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "vars": {
    "COLLECTOR_SCHEMA_VERSION": "mobile-suica-worker-poc-v2"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "SCHEDULE_DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60"
    }
  ]
}
