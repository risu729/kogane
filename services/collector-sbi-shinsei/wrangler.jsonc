{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-sbi-shinsei-collector-poc",
  "main": "src/schedule-entrypoint.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": true,
  "preview_urls": false,
  "placement": {
    "region": "aws:ap-northeast-1"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "containers": [
    {
      "class_name": "SbiShinseiCollectorContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic",
      "constraints": {
        "regions": ["APAC"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLECTOR_CONTAINER",
        "class_name": "SbiShinseiCollectorContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SbiShinseiCollectorContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "kogane-raw-evidence"
    }
  ],
  "vpc_networks": [
    {
      "binding": "MESH",
      "tunnel_id": "6b0ccf30-68b2-494e-baa8-f4f9f3e46b33",
      "remote": true
    }
  ],
  "vars": {
    "COLLECTOR_SCHEMA_VERSION": "sbi-shinsei-worker-poc-v1",
    "RELAY_PUBLIC_URL": "wss://kogane-sbi-shinsei-collector-poc.takuanimal.workers.dev/tcp"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "SCHEDULE_DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60"
    }
  ]
}
