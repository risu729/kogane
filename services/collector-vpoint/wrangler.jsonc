{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-vpoint-collector-poc",
  "main": "src/schedule-entrypoint.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "exports": {
    "VPointSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VPOINT_SESSION",
        "class_name": "VPointSession"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "kogane-raw-evidence"
    }
  ],
  "vars": {
    "COLLECTOR_SCHEMA_VERSION": "vpoint-worker-poc-v2",
    "VPOINT_PAY_EMAIL_RECIPIENT": "vpointpay@takuk.me"
  },
  "secrets": {
    "required": [
      "VPOINT_MEMBER_NUMBER",
      "VPOINT_EMAIL_RECIPIENT",
      "VPOINT_EMAIL_FORWARD_TO",
      "ADMIN_TRIGGER_TOKEN"
    ]
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "SCHEDULE_DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60"
    }
  ]
}
