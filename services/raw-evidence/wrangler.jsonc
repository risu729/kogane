{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kogane-ingest",
  "account_id": "59ea63cc00914b30ca410b062ae2bb7f",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kogane-raw-evidence",
      "database_id": "b335a887-250d-45c9-bd72-af83f35fdc60",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "kogane-raw-evidence"
    }
  ]
}
