{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The shared packages import each other with explicit `.ts` specifiers
    // (U05); esbuild resolves them and nothing here emits.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    // This Worker reaches CORE through packages/application, whose ingest use
    // cases now include the Drizzle pilot's reads (U12). drizzle-orm 0.45.2's
    // declaration files do not type-check under TypeScript 7.0.2 on their own:
    // 85 errors, all inside drizzle-orm (gel/mysql/pg/singlestore/sqlite-core
    // and d1/driver.d.ts) — `Buffer` without `@types/node`, optional peer
    // modules that are not installed (`gel`, `mysql2/promise`, `@miniflare/d1`)
    // and `keyof this` constraints TS 7 rejects. None is in repository code,
    // so library declarations are trusted here, exactly as every package
    // tsconfig in this repository already trusts them; this Worker's own
    // sources are still checked in full (docs/storage-d1.md, "Drizzle pilot").
    "skipLibCheck": true,
    "types": []
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
